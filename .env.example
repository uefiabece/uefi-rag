# Onde estão os repositórios UÉFIabecê (sobrescreve corpus.config.json)
# UEFI_ROOT=E:/Bibliotecas/Documentos/PROGRAMMING/UEFIabc

# Banco: sem DATABASE_URL usa PGlite (Postgres + pgvector em WASM) em ./data/pglite
# DATABASE_URL=postgres://rag:rag@localhost:5432/rag

# Embeddings: ollama (padrão, bge-m3) ou openai
EMBED_PROVIDER=ollama
EMBED_MODEL=bge-m3
OLLAMA_URL=http://127.0.0.1:11434

# Geração: anthropic (padrão), openai ou ollama
LLM_PROVIDER=anthropic
LLM_MODEL=claude-opus-5
# ANTHROPIC_API_KEY=...
# OPENAI_API_KEY=...

# Servidor HTTP
PORT=8787
# PUBLIC_ONLY=1   # responde só com documentos de repositórios públicos
