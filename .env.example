# Onde estão os repositórios UÉFIabecê (sobrescreve corpus.config.json)
# UEFI_ROOT=E:/Bibliotecas/Documentos/PROGRAMMING/UEFIabc

# Banco: sem DATABASE_URL usa PGlite (Postgres + pgvector em WASM) em ./data/pglite
# DATABASE_URL=postgres://rag:rag@localhost:5432/rag

# Embeddings: ollama (padrão, bge-m3) ou openai
EMBED_PROVIDER=ollama
EMBED_MODEL=bge-m3
OLLAMA_URL=http://127.0.0.1:11434

# Geração: anthropic (padrão), openai ou ollama
LLM_PROVIDER=anthropic
LLM_MODEL=claude-opus-5
# ANTHROPIC_API_KEY=...
# OPENAI_API_KEY=...
# OPENAI_BASE_URL=https://openrouter.ai/api/v1   # qualquer API compatível com a da OpenAI

# Servidor HTTP
PORT=8787
# PUBLIC_ONLY=1

# Spans por etapa (OpenTelemetry, OTLP/HTTP). Sem endpoint, nada é exportado.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318                         # Jaeger: docker compose --profile traces up -d jaeger
# OTEL_EXPORTER_OTLP_ENDPOINT=https://cloud.langfuse.com/api/public/otel     # Langfuse
# OTEL_EXPORTER_OTLP_HEADERS=Authorization=Basic <base64 de pk:sk>
# OTEL_CAPTURE_CONTENT=1   # inclui pergunta e resposta nos spans
# TRACES_LOCAL=0           # não grava traces no banco (aba Observabilidade)   # responde só com documentos de repositórios públicos
